{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["build", "^build"], "outputs": [] },
    "pack": { "dependsOn": ["build"], "outputs": ["*.tgz"] }
  }
}
