{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "noEmit": false,
    "rootDir": "."
  },
  "include": [
    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/webview/shared/presentation/**/*.ts",
    "src/webview/features/event-presentation/model.ts",
    "src/webview/providers/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
