{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@application/*": ["./src/application/*"],
      "@engine/*": ["./src/engine/*"],
      "@profiles/*": ["./src/profiles/*"],
      "@aggregation/*": ["./src/aggregation/*"],
      "@extension/*": ["./src/extension/*"],
      "@experimental/*": ["./src/experimental/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@webview/*": ["./src/webview/*"],
      "@features/*": ["./src/webview/features/*"],
      "@widgets/*": ["./src/webview/widgets/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vscode",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts"
  ]
}
