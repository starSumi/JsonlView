{
  "name": "jsonl-view",
  "displayName": "JsonlView",
  "description": "A bounded JSONL event studio for logs, telemetry, traces, coding-agent runs, and local agent session history.",
  "version": "0.2.12",
  "publisher": "Sumi-Sophia",
  "icon": "images/jsonlview-icon.png",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/starSumi/JsonlView.git"
  },
  "homepage": "https://github.com/starSumi/JsonlView#readme",
  "bugs": {
    "url": "https://github.com/starSumi/JsonlView/issues"
  },
  "files": [
    "dist",
    "native/jsonl-core/*.node",
    "native/jsonl-core/index.d.ts",
    "native/jsonl-core/package.json",
    "README.md",
    "CHANGELOG.md",
    "package.nls.json",
    "images/jsonlview-icon.png",
    "LICENSE.txt",
    "THIRD-PARTY-NOTICES.txt",
    "docs/format-and-profile-boundaries.md",
    "docs/assets/claude-diff.png",
    "docs/assets/codex-timeline-exec.png",
    "docs/assets/paste-jsonl-source.png",
    "docs/assets/pi-system-prompt.png",
    "docs/assets/rollout-event-insights.png",
    "docs/assets/session-navigator-opt-in.png",
    "third_party/licenses"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.136.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "jsonl",
    "ndjson",
    "logs",
    "agent",
    "codex",
    "claude",
    "pi",
    "coding-agent",
    "agent-history",
    "session-history",
    "agent-sessions",
    "session-navigator",
    "transcript-viewer",
    "opentelemetry",
    "trace",
    "observability"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "jsonlView.acp.command",
        "jsonlView.acp.args",
        "jsonlView.acp.timeoutMs",
        "jsonlView.acp.profiles"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "JsonlView currently requires file-backed random access."
    }
  },
  "contributes": {
    "commands": [
      { "command": "jsonlView.sessionNavigator.collections.create", "title": "JsonlView: New Collection", "icon": "$(new-folder)" },
      { "command": "jsonlView.sessionNavigator.collections.rename", "title": "Rename Collection" },
      { "command": "jsonlView.sessionNavigator.collections.delete", "title": "Delete Collection" },
      { "command": "jsonlView.sessionNavigator.collections.fileInto", "title": "Add Reference to Collection…" },
      { "command": "jsonlView.sessionNavigator.collections.addReference", "title": "Add Existing Reference…", "icon": "$(add)" },
      { "command": "jsonlView.sessionNavigator.openImportCanvas", "title": "Import", "icon": "$(cloud-download)" },
      { "command": "jsonlView.sessionNavigator.collections.unfile", "title": "Remove Reference from Collection" },
      { "command": "jsonlView.sessionNavigator.collections.open", "title": "Open Reference in JsonlView" },
      { "command": "jsonlView.sessionNavigator.collections.alias", "title": "Rename Reference Alias…" },
      { "command": "jsonlView.sessionNavigator.collections.archive", "title": "Set Local Archive Intent" },
      { "command": "jsonlView.sessionNavigator.collections.restore", "title": "Clear Local Archive Intent" },
      { "command": "jsonlView.sessionNavigator.collections.rebind", "title": "Rebind Reference…" },
      { "command": "jsonlView.sessionNavigator.collections.refresh", "title": "JsonlView: Refresh Collections", "icon": "$(refresh)" },
      {
        "command": "jsonlView.open",
        "title": "JsonlView: Open as Data Studio",
        "icon": "$(table)"
      },
      {
        "command": "jsonlView.exportRawSource",
        "title": "JsonlView: Export Entire Raw JSONL Source…",
        "icon": "$(export)"
      },
      { "command": "jsonlView.exportRawRecords", "title": "JsonlView: Export Selected / Range / Matching Raw Records…", "icon": "$(export)" },
      { "command": "jsonlView.recoverRawExport", "title": "JsonlView: Inspect or Retry Raw Export…", "icon": "$(history)" },
      {
        "command": "jsonlView.rebuildIndex",
        "title": "JsonlView: Rebuild Index",
        "icon": "$(refresh)"
      },
      {
        "command": "jsonlView.queryRustPage",
        "title": "JsonlView: Query Current Page with Rust Data Plane",
        "icon": "$(search)",
        "enablement": "resourceExtname == .jsonl || resourceExtname == .ndjson"
      },
      {
        "command": "jsonlView.sendLastDiagnosticViaAcp",
        "title": "JsonlView: Send Last Diagnostic via ACP",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "jsonlView.diagnoseWebview",
        "title": "JsonlView: Diagnose Webview Host Error",
        "icon": "$(question)"
      },
      {
        "command": "jsonlView.showOutput",
        "title": "JsonlView: Show Output Log",
        "icon": "$(output)"
      },
      {
        "command": "jsonlView.explainLastDiagnostic",
        "title": "JsonlView: Explain Last Diagnostic with VS Code Chat",
        "icon": "$(sparkle)"
      },
      {
        "command": "jsonlView.copyLastDiagnostic",
        "title": "JsonlView: Copy Last Diagnostic Context",
        "icon": "$(copy)"
      },
      {
        "command": "jsonlView.sendLastDiagnosticToSideAgent",
        "title": "JsonlView: Send Last Diagnostic to Side Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "jsonlView.sessionNavigator.enable",
        "title": "JsonlView: Enable Session Navigator",
        "icon": "$(activate-breakpoints)"
      },
      {
        "command": "jsonlView.sessionNavigator.disable",
        "title": "JsonlView: Disable Session Navigator",
        "icon": "$(circle-slash)"
      },
      {
        "command": "jsonlView.sessionNavigator.settings",
        "title": "JsonlView: Session Navigator Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "jsonlView.sessionNavigator.mcpCapability",
        "title": "JsonlView: Inspect MCP Navigation Capability",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "jsonlView.previews.open",
        "title": "Open Temporary Preview",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jsonlView.previews.saveAs",
        "title": "Save Preview As…",
        "icon": "$(save-as)"
      },
      {
        "command": "jsonlView.previews.openSavedCopy",
        "title": "Open Saved Preview Copy"
      },
      {
        "command": "jsonlView.sessionNavigator.addSource",
        "title": "JsonlView: Add Source",
        "icon": "$(add)"
      },
      {
        "command": "jsonlView.sessionNavigator.authorizeAgent",
        "title": "JsonlView: Connect Local Agent"
      },
      {
        "command": "jsonlView.sessionNavigator.source.files",
        "title": "JsonlView: Add JSONL Files"
      },
      {
        "command": "jsonlView.sessionNavigator.source.folder",
        "title": "JsonlView: Add Local Folder"
      },
      {
        "command": "jsonlView.sessionNavigator.source.paste",
        "title": "JsonlView: Paste JSONL Source"
      },
      {
        "command": "jsonlView.sessionNavigator.source.authorizeDetected",
        "title": "JsonlView: Authorize Detected Agent"
      },
      {
        "command": "jsonlView.sessionNavigator.sort",
        "title": "JsonlView: Sort Sessions",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "jsonlView.sessionNavigator.removeSource",
        "title": "JsonlView: Remove Agent Source",
        "icon": "$(trash)"
      },
      {
        "command": "jsonlView.sessionNavigator.loadMore",
        "title": "JsonlView: Load More Sessions",
        "icon": "$(fold-down)"
      },
      {
        "command": "jsonlView.sessionNavigator.refresh",
        "title": "JsonlView: Refresh Session Navigator",
        "icon": "$(refresh)"
      },
      {
        "command": "jsonlView.sessionNavigator.open",
        "title": "JsonlView: Open Agent Sessions"
      },
      {
        "command": "jsonlView.sessionNavigator.sortActivity",
        "title": "JsonlView: Sort Sessions by Recent Activity"
      },
      {
        "command": "jsonlView.sessionNavigator.sortCreated",
        "title": "JsonlView: Sort Sessions by Created Time"
      },
      {
        "command": "jsonlView.sessionNavigator.sortTitle",
        "title": "JsonlView: Sort Sessions by Title"
      },
      {
        "command": "jsonlView.sessionNavigator.addSourceFromClipboard",
        "title": "JsonlView: Paste JSONL Source"
      },
      {
        "command": "jsonlView.sessionNavigator.openEntity",
        "title": "Open in JsonlView"
      },
      {
        "command": "jsonlView.sessionNavigator.openEntityWith",
        "title": "Open With JsonlView Data Studio"
      },
      {
        "command": "jsonlView.sessionNavigator.revealInFileExplorer",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "jsonlView.sessionNavigator.openInIntegratedTerminal",
        "title": "Open in Integrated Terminal"
      },
      {
        "command": "jsonlView.sessionNavigator.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "jsonlView.sessionNavigator.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "jsonlView.sessionNavigator.openTimeline",
        "title": "Open Timeline"
      },
      {
        "command": "jsonlView.sessionNavigator.copySessionId",
        "title": "Copy Session ID"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jsonlViewSessionNavigator",
          "title": "Agent Sessions",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "jsonlViewSessionNavigator": [
        {
          "id": "jsonlView.sourceDrop",
          "name": "Collections"
        },
        {
          "id": "jsonlView.sessionNavigator",
          "name": "Agent Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jsonlView.sessionNavigator",
        "when": "!config.jsonlView.sessionNavigator.enabled",
        "contents": "Session Navigator is built in. Enable it to browse local Agent sources. Source authorization is separate.\n[Enable Session Navigator](command:jsonlView.sessionNavigator.enable)\n[Open Settings](command:jsonlView.sessionNavigator.settings)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "jsonlView.sessionNavigator.collections.rename", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.delete", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.fileInto", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.addReference", "when": "false" },
        { "command": "jsonlView.sessionNavigator.openImportCanvas", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.unfile", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.open", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.alias", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.archive", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.restore", "when": "false" },
        { "command": "jsonlView.sessionNavigator.collections.rebind", "when": "false" },
        {
          "command": "jsonlView.sendLastDiagnosticViaAcp",
          "when": "isWorkspaceTrusted"
        }
      ],
      "view/title": [
        { "command": "jsonlView.sessionNavigator.openImportCanvas", "when": "view == jsonlView.sourceDrop", "group": "navigation@1" },
        { "command": "jsonlView.exportRawSource", "when": "view == jsonlView.sourceDrop", "group": "export@1" },
        { "command": "jsonlView.exportRawRecords", "when": "view == jsonlView.sourceDrop", "group": "export@2" },
        { "command": "jsonlView.recoverRawExport", "when": "view == jsonlView.sourceDrop", "group": "export@3" },
        { "command": "jsonlView.sessionNavigator.collections.create", "when": "view == jsonlView.sourceDrop", "group": "collections@1" },
        { "command": "jsonlView.sessionNavigator.collections.refresh", "when": "view == jsonlView.sourceDrop", "group": "collections@2" },
        {
          "command": "jsonlView.sessionNavigator.refresh",
          "when": "view == jsonlView.sessionNavigator && config.jsonlView.sessionNavigator.enabled",
          "group": "navigation@1"
        },
        {
          "command": "jsonlView.sessionNavigator.addSource",
          "when": "view == jsonlView.sessionNavigator && config.jsonlView.sessionNavigator.enabled",
          "group": "navigation@2"
        },
        {
          "command": "jsonlView.sessionNavigator.enable",
          "when": "view == jsonlView.sessionNavigator && !config.jsonlView.sessionNavigator.enabled",
          "group": "settings@1"
        },
        {
          "command": "jsonlView.sessionNavigator.disable",
          "when": "view == jsonlView.sessionNavigator && config.jsonlView.sessionNavigator.enabled",
          "group": "settings@2"
        },
        {
          "command": "jsonlView.sessionNavigator.sort",
          "when": "view == jsonlView.sessionNavigator",
          "group": "navigation@3"
        },
        {
          "command": "jsonlView.sessionNavigator.sortActivity",
          "when": "view == jsonlView.sessionNavigator",
          "group": "sort@1"
        },
        {
          "command": "jsonlView.sessionNavigator.sortCreated",
          "when": "view == jsonlView.sessionNavigator",
          "group": "sort@2"
        },
        {
          "command": "jsonlView.sessionNavigator.sortTitle",
          "when": "view == jsonlView.sessionNavigator",
          "group": "sort@3"
        },
        {
          "command": "jsonlView.sessionNavigator.authorizeAgent",
          "when": "view == jsonlView.sessionNavigator",
          "group": "sources@1"
        },
        {
          "command": "jsonlView.diagnoseWebview",
          "when": "view == jsonlView.sessionNavigator",
          "group": "help@1"
        }
      ],
      "explorer/context": [
        {
          "command": "jsonlView.open",
          "when": "resourceExtname == .jsonl || resourceExtname == .ndjson",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        { "command": "jsonlView.exportRawSource", "when": "activeCustomEditorId == jsonlView.editor", "group": "export@1" },
        { "command": "jsonlView.exportRawRecords", "when": "activeCustomEditorId == jsonlView.editor", "group": "export@2" }
      ],
      "view/item/context": [
        { "command": "jsonlView.sessionNavigator.collections.addReference", "when": "view == jsonlView.sourceDrop && viewItem == jsonlView.collection", "group": "inline@1" },
        { "command": "jsonlView.sessionNavigator.collections.rename", "when": "view == jsonlView.sourceDrop && viewItem == jsonlView.collection", "group": "collections@1" },
        { "command": "jsonlView.sessionNavigator.collections.delete", "when": "view == jsonlView.sourceDrop && viewItem == jsonlView.collection", "group": "collections@2" },
        { "command": "jsonlView.sessionNavigator.collections.open", "when": "view == jsonlView.sourceDrop && viewItem =~ /^jsonlView\\.collection\\.entry\\.(?:session|file|source)(?:\\.archived)?$/", "group": "navigation@1" },
        { "command": "jsonlView.sessionNavigator.collections.fileInto", "when": "view == jsonlView.sourceDrop && viewItem =~ /^jsonlView\\.collection\\.entry\\./", "group": "collections@1" },
        { "command": "jsonlView.sessionNavigator.collections.unfile", "when": "view == jsonlView.sourceDrop && viewItem =~ /^jsonlView\\.collection\\.entry\\./", "group": "collections@2" },
        { "command": "jsonlView.sessionNavigator.collections.alias", "when": "view == jsonlView.sourceDrop && viewItem =~ /^jsonlView\\.collection\\.entry\\.(?:session|file|source)/", "group": "collections@3" },
        { "command": "jsonlView.sessionNavigator.collections.archive", "when": "view == jsonlView.sourceDrop && viewItem == jsonlView.collection.entry.session", "group": "collections@4" },
        { "command": "jsonlView.sessionNavigator.collections.restore", "when": "view == jsonlView.sourceDrop && viewItem =~ /^jsonlView\\.collection\\.entry\\.(?:session|unavailable)\\.archived$/", "group": "collections@4" },
        { "command": "jsonlView.sessionNavigator.collections.rebind", "when": "view == jsonlView.sourceDrop && viewItem =~ /^jsonlView\\.collection\\.entry\\./", "group": "collections@5" },
        { "command": "jsonlView.sessionNavigator.collections.fileInto", "when": "view == jsonlView.sessionNavigator && viewItem =~ /^jsonlView\\.sessionNavigator\\.(?:entity|source(?:\\.partial)?)$/", "group": "collections@1" },
        {
          "command": "jsonlView.previews.open",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.preview.temporary",
          "group": "navigation@1"
        },
        {
          "command": "jsonlView.previews.saveAs",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.preview.temporary",
          "group": "inline@1"
        },
        {
          "command": "jsonlView.previews.openSavedCopy",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.preview.savedCopy",
          "group": "open@1"
        },
        {
          "command": "jsonlView.sessionNavigator.loadMore",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.source.partial",
          "group": "inline@0"
        },
        {
          "command": "jsonlView.sessionNavigator.removeSource",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.source",
          "group": "inline@1"
        },
        {
          "command": "jsonlView.sessionNavigator.revealInFileExplorer",
          "when": "view == jsonlView.sessionNavigator && viewItem =~ /^jsonlView\\.sessionNavigator\\.source(?:\\.partial)?$/",
          "group": "navigation@3"
        },
        {
          "command": "jsonlView.sessionNavigator.openInIntegratedTerminal",
          "when": "view == jsonlView.sessionNavigator && viewItem =~ /^jsonlView\\.sessionNavigator\\.source(?:\\.partial)?$/",
          "group": "navigation@4"
        },
        {
          "command": "jsonlView.sessionNavigator.copyPath",
          "when": "view == jsonlView.sessionNavigator && viewItem =~ /^jsonlView\\.sessionNavigator\\.source(?:\\.partial)?$/",
          "group": "copy@1"
        },
        {
          "command": "jsonlView.sessionNavigator.copyRelativePath",
          "when": "view == jsonlView.sessionNavigator && viewItem =~ /^jsonlView\\.sessionNavigator\\.source(?:\\.partial)?$/",
          "group": "copy@2"
        },
        {
          "command": "jsonlView.sessionNavigator.openEntity",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "navigation@1"
        },
        {
          "command": "jsonlView.sessionNavigator.openEntityWith",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "navigation@2"
        },
        {
          "command": "jsonlView.sessionNavigator.revealInFileExplorer",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "navigation@3"
        },
        {
          "command": "jsonlView.sessionNavigator.openInIntegratedTerminal",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "navigation@4"
        },
        {
          "command": "jsonlView.sessionNavigator.copyPath",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "copy@1"
        },
        {
          "command": "jsonlView.sessionNavigator.copyRelativePath",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "copy@2"
        },
        {
          "command": "jsonlView.sessionNavigator.copySessionId",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "copy@3"
        },
        {
          "command": "jsonlView.sessionNavigator.openTimeline",
          "when": "view == jsonlView.sessionNavigator && viewItem == jsonlView.sessionNavigator.entity",
          "group": "timeline@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "jsonlView.editor",
        "displayName": "JsonlView Data Studio",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "JsonlView",
      "properties": {
        "jsonlView.telemetry.otlp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Explicitly enable query-duration metrics export from this extension host to the configured OTLP/HTTP endpoint. No export is mounted by default."
        },
        "jsonlView.telemetry.otlp.endpoint": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Explicit OTLP/HTTP metrics URL ending in /v1/metrics. HTTPS is required except for loopback HTTP; workspace settings cannot override this destination."
        },
        "jsonlview.telemetry.otlp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Explicitly enable query-duration metrics export from this extension host to the configured OTLP/HTTP endpoint. No export is mounted by default.",
          "deprecationMessage": "Deprecated setting. Use `jsonlView.telemetry.otlp.enabled` instead."
        },
        "jsonlview.telemetry.otlp.endpoint": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Explicit OTLP/HTTP metrics URL ending in /v1/metrics. HTTPS is required except for loopback HTTP; workspace settings cannot override this destination.",
          "deprecationMessage": "Deprecated setting. Use `jsonlView.telemetry.otlp.endpoint` instead."
        },
        "jsonlView.hydration.maxBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 65536,
          "maximum": 4194304,
          "description": "Maximum bytes automatically hydrated for one JSONL record."
        },
        "jsonlView.hydration.fullMaxBytes": {
          "type": "number",
          "default": 16777216,
          "minimum": 1048576,
          "maximum": 268435456,
          "description": "Maximum bytes read when Show full is explicitly requested for one record."
        },
        "jsonlView.hydration.pageMaxBytes": {
          "type": "number",
          "default": 8388608,
          "minimum": 1048576,
          "maximum": 268435456,
          "description": "Soft aggregate bytes hydrated for one visible page; one boundary record may exceed it to preserve progress."
        },
        "jsonlView.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 20,
          "maximum": 500,
          "description": "Rows requested per viewport page."
        },
        "jsonlView.profile.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Suggest a semantic profile when bounded samples provide sufficient evidence."
        },
        "jsonlView.acp.command": {
          "type": "string",
          "default": "",
          "description": "Optional local ACP agent executable. It starts only when Send Last Diagnostic via ACP is invoked."
        },
        "jsonlView.acp.args": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Arguments passed to the explicitly configured ACP agent."
        },
        "jsonlView.acp.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Bounded timeout for each ACP handshake or prompt request."
        },
        "jsonlView.acp.profiles": {
          "type": "array",
          "description": "Optional local ACP v1 stdio agents. Each profile is launched only after an explicit Send Last Diagnostic via ACP action; selecting no agent starts no process.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "adapterId": { "type": "string", "enum": ["generic.acp-v1"], "default": "generic.acp-v1" },
              "label": { "type": "string", "minLength": 1, "maxLength": 128 },
              "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } },
              "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
              "executionTarget": { "type": "string", "enum": ["local"], "default": "local" },
              "protocolVersion": { "type": "string", "enum": ["1"], "default": "1" },
              "transport": { "type": "string", "enum": ["stdio"], "default": "stdio" }
            },
            "required": ["id", "label", "command", "args", "timeoutMs"]
          }
        },
        "jsonlView.native.newlineScanner": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "on"
          ],
          "enumDescriptions": [
            "Use the adaptive Node scanner and never probe native code.",
            "Experimentally benchmark the native scanner on win32-x64 and keep it only when it wins by at least 10%.",
            "Prefer the native scanner, with ABI validation and automatic fallback on any failure."
          ],
          "default": "off",
          "description": "Experimental Rust newline scanner. Native failures always fall back to the bounded Node implementation."
        },
        "jsonlView.experimental.stagedMutation.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to the staged mutation experiment. A trusted workspace, separately authorized source, and explicit user gesture are still required; source files remain unchanged until a future commit flow is enabled."
        },
        "jsonlView.sessionNavigator.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to the read-only Agent Session Navigator. Standard Codex, Claude, and pi roots plus explicitly configured generic agent homes are detected; custom roots remain explicit."
        },
        "jsonlView.sessionNavigator.hideArchivedCollectionSessions": {
          "type": "boolean",
          "default": false,
          "description": "Hide sessions with an archived reference in a Collection from Agent Sessions. Archive intent remains Collection metadata; restoring the reference or removing its last Collection membership makes the session visible again. Missing Collection metadata leaves sessions visible."
        },
        "jsonlView.sessionNavigator.sort": {
          "type": "string",
          "enum": ["activity", "created", "title"],
          "enumDescriptions": [
            "Recent activity first, using provider metadata and a stable ID tie-breaker.",
            "Session start time first.",
            "Product or provider title, then stable ID."
          ],
          "default": "activity",
          "description": "Session Navigator ordering. Source folder dates are never used as activity time."
        },
        "jsonlView.sessionNavigator.sources": {
          "type": "array",
          "default": [],
          "description": "Additional local Agent source roots. Standard Codex, Claude, pi, and Kimi Code roots plus explicit Gemini, OpenCode, and AgentsView homes may be detected as candidates; scanning requires separate source authorization. All paths are read-only.",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": ["codex", "claude", "pi", "kimi", "gemini", "opencode", "agentsview", "generic"]
              },
              "rootUri": {
                "type": "string",
                "description": "A local file URI selected through Add Source or Connect Local Agent."
              },
              "stateRootUri": {
                "type": "string",
                "description": "Optional provider-owned SQLite state home URI detected for Codex."
              }
            },
            "required": ["provider", "rootUri"]
          }
        }
      }
    }
  },
