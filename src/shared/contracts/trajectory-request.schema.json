{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jsonlview:trajectory-slice:request:v1",
  "title": "JsonlView trajectory slice request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "sourceId",
    "predicate"
  ],
  "properties": {
    "schema": {
      "const": "jsonlview.trajectory-slice.request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "actor": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ]
        },
        "hasError": {
          "type": "boolean"
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "default": 50
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576,
      "default": 262144
    },
    "maxExaminedBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 67108864,
      "default": 8388608
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 5000
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
