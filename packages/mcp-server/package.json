{
  "name": "@jsonlview/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "jsonlview-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/mcp-server-runtime.d.ts",
      "import": "./dist/mcp-server-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
